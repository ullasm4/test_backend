PORT=3000
DATABASE_URL=postgresql://postgres:your_password@new-database.c7woc2iyy6qb.ap-south-1.rds.amazonaws.com:5432/postgres
DB_SSL=true

# Local development uses .env
# Production deployment uses .env.live (uploaded by src/databaseWith.sh)

# ── Database dump to S3 (POST /dashboard/dump-s3) ──
# Uses backup account credentials below
AWS_REGION_BACKUP=ap-south-1
AWS_ACCESS_KEY_ID_BACKUP=your_backup_access_key
AWS_SECRET_ACCESS_KEY_BACKUP=your_backup_secret_key
S3_BUCKET_NAME_BACKUP=contracts-information
S3_DUMP_PREFIX=backup

# ── S3 cross-account migration (npm run s3-migrate) ──
# Old bucket (source account)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_old_access_key
AWS_SECRET_ACCESS_KEY=your_old_secret_key
S3_BUCKET_NAME=old-bucket-name
SOURCE_S3_BUCKET=old-bucket-name

# New bucket (destination account)
AWS_REGION_2=ap-south-1
AWS_ACCESS_KEY_ID_2=your_new_access_key
AWS_SECRET_ACCESS_KEY_2=your_new_secret_key
AWS_S3_BUCKET_NAME_2=new-bucket-name
DEST_S3_BUCKET=new-bucket-name

SOURCE_S3_PREFIX=
DEST_S3_PREFIX=
S3_COPY_CONCURRENCY=5
S3_SKIP_EXISTING=true
# Optional: DB_URL_COLUMNS=users.avatar_url,products.image_url
DB_URL_COLUMNS=

# ── Amazon SES v2 (npm run ses:create-template) ──
# Falls back to AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if unset
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key
# Optional defaults when not passing --name / --file
SES_TEMPLATE_NAME=WelcomeEmail
SES_TEMPLATE_SUBJECT=Welcome, {{name}}!
SES_TEMPLATE_HTML=<h1>Welcome, {{name}}!</h1><p>{{message}}</p>
SES_TEMPLATE_TEXT=Welcome, {{name}}!\n\n{{message}}

# ── SMTP mail (direct email send) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_or_app_password
SMTP_FROM=your_email@example.com
SMTP_SECURE=false
